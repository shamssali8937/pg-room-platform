generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // NOTE: The 'url' property has been moved to prisma.config.ts for Prisma 7 compatibility
}

// --- 13.1 Users ---
model User {
  id                  String    @id @default(uuid())
  role                String    @default("tenant") // admin, owner, tenant
  full_name           String
  mobile_number       String?   @unique
  email               String    @unique
  password_hash       String?
  profile_photo_url   String?
  city                String?
  account_status      String    @default("active")
  mobile_verified_at  DateTime?
  email_verified_at   DateTime?
  email_verify_token  String?
  phone_otp           String?
  phone_otp_expiry    DateTime?
  verification_status      String    @default("pending")
  certification_expires_at DateTime?
  card_number              String?
  card_expiry         String?
  card_cvv            String?
  card_holder         String?
  balance             Float     @default(100000.0)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  reset_token         String?
  reset_token_expiry  DateTime?
  failed_login_attempts Int     @default(0)   // Phase 1: lockout tracking
  locked_until        DateTime?               // Phase 1: lockout expiry

  // Relationships
  rooms               Room[]
  saved_rooms         SavedRoom[]
  bookings_as_tenant  Booking[]           @relation("TenantBookings")
  bookings_as_owner   Booking[]           @relation("OwnerBookings")
  sent_messages       Message[]           @relation("SentMessages")
  received_messages   Message[]           @relation("ReceivedMessages")
  conversations_tenant Conversation[]    @relation("TenantConversations")
  conversations_owner  Conversation[]    @relation("OwnerConversations")
  reviews_given       Review[]            @relation("Reviewer")
  reviews_received    Review[]            @relation("Reviewee")
  reports_filed       Report[]
  points_transactions PointsTransaction[]
  notifications       Notification[]
  admin_actions       AdminAction[]
  refresh_tokens      RefreshToken[]
  documents           UserDocument[]
  blocked_by          BlockedUser[]       @relation("Blocked")
  blocking            BlockedUser[]       @relation("Blocker")
  sent_offers         BookingOffer[]      @relation("SentOffers")
  received_offers     BookingOffer[]      @relation("ReceivedOffers")
  reactions           Reaction[]

  @@index([email])
  @@index([mobile_number])
}

// --- User Documents (for identity verification) ---
model UserDocument {
  id          String   @id @default(uuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  doc_type    String   // cnic, photo, employment, bank
  file_url    String
  status      String   @default("pending") // pending, verified, rejected
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([user_id])
}

// --- 13.2 Rooms ---
model Room {
  id                      String    @id @default(uuid())
  owner_id                String
  owner                   User      @relation(fields: [owner_id], references: [id])
  title                   String
  description             String?
  city                    String
  address                 String    @default("")
  locality                String    @default("")
  landmark                String?
  approximate_latitude    Float?
  approximate_longitude   Float?
  room_type               String
  furnished_status        String    @default("unfurnished")
  beds                    Int       @default(1)
  baths                   Int       @default(1)
  size_value              Float     @default(0)
  size_unit               String    @default("sqft")
  price                   Int       @default(0)       // main price field (frontend uses this)
  rent_amount             Int       @default(0)       // alias kept for compatibility
  price_unit              String    @default("month")
  security_deposit_amount Int       @default(0)
  available_for           String    @default("any")
  availability_date       DateTime  @default(now())
  gender_preference       String    @default("any")
  rules_json              Json?
  amenities_list          String[]  @default([])      // flat list for easy querying
  status                  String    @default("pending")
  approved_at             DateTime?
  rejected_reason         String?
  is_boosted              Boolean   @default(false)
  is_featured             Boolean   @default(false)
  boost_expires_at        DateTime?
  featured_expires_at     DateTime?
  views                   Int       @default(0)
  is_verified             Boolean   @default(false)
  rating                  Float?
  review_count            Int       @default(0)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  // Relationships
  images              RoomImage[]
  amenities           RoomAmenity[]
  saved_by_users      SavedRoom[]
  bookings            Booking[]
  conversations       Conversation[]
  reviews             Review[]
  points_transactions PointsTransaction[]
  booking_offers      BookingOffer[]

  @@index([city])
  @@index([status])
  @@index([owner_id])
  @@index([views])           // default sort column — was causing full table scan
  @@index([price])           // price_asc / price_desc sort
  @@index([created_at])      // newest sort
  @@index([is_boosted])      // boosted listing filter
  @@index([is_featured])     // featured listing filter
  // Compound: filter by status then sort — avoids separate filter + sort passes
  @@index([status, views])
  @@index([status, price])
  @@index([status, created_at])
}

// --- 13.3 RoomImages ---
model RoomImage {
  id                String   @id @default(uuid())
  room_id           String
  room              Room     @relation(fields: [room_id], references: [id], onDelete: Cascade)
  file_url          String
  file_hash         String?
  sort_order        Int      @default(0)
  moderation_status String   @default("approved")
  created_at        DateTime @default(now())
}

// --- 13.4 Amenities ---
model Amenity {
  id       String        @id @default(uuid())
  name     String        @unique
  category String
  rooms    RoomAmenity[]
}

// --- 13.5 RoomAmenities ---
model RoomAmenity {
  room_id    String
  room       Room    @relation(fields: [room_id], references: [id], onDelete: Cascade)
  amenity_id String
  amenity    Amenity @relation(fields: [amenity_id], references: [id])

  @@id([room_id, amenity_id])
}

// --- 13.6 SavedRooms ---
model SavedRoom {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id])
  room_id    String
  room       Room     @relation(fields: [room_id], references: [id])
  created_at DateTime @default(now())

  @@unique([user_id, room_id])
  @@index([user_id])
  @@index([room_id])
}

// --- 13.7 Bookings ---
model Booking {
  id           String    @id @default(uuid())
  room_id      String
  room         Room      @relation(fields: [room_id], references: [id])
  tenant_id    String
  tenant       User      @relation("TenantBookings", fields: [tenant_id], references: [id])
  owner_id     String
  owner        User      @relation("OwnerBookings", fields: [owner_id], references: [id])
  request_type String    @default("inquiry")
  status       String    @default("pending")
  message      String?
  owner_note   String?
  expires_at   DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  reviews      Review[]

  @@index([status])
  @@index([tenant_id])
  @@index([owner_id])
  @@index([room_id])
}

// --- 13.9 Conversations ---
model Conversation {
  id                  String    @id @default(uuid())
  room_id             String?
  room                Room?     @relation(fields: [room_id], references: [id])
  tenant_id           String
  tenant              User      @relation("TenantConversations", fields: [tenant_id], references: [id])
  owner_id            String
  owner               User      @relation("OwnerConversations", fields: [owner_id], references: [id])
  conversation_status String    @default("active")
  
  // Custom flags for archive, pin, mute, soft delete
  is_pinned_tenant    Boolean   @default(false)
  is_pinned_owner     Boolean   @default(false)
  is_archived_tenant  Boolean   @default(false)
  is_archived_owner   Boolean   @default(false)
  is_muted_tenant     Boolean   @default(false)
  is_muted_owner      Boolean   @default(false)
  deleted_at_tenant   DateTime?
  deleted_at_owner    DateTime?
  
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  messages            Message[]
  booking_offers      BookingOffer[]

  @@index([tenant_id])
  @@index([owner_id])
  @@index([updated_at])
}

// --- 13.8 Messages ---
model Message {
  id              String       @id @default(uuid())
  conversation_id String
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender_id       String
  sender          User         @relation("SentMessages", fields: [sender_id], references: [id])
  receiver_id     String
  receiver        User         @relation("ReceivedMessages", fields: [receiver_id], references: [id])
  message_body    String
  message_type    String       @default("text") // text, image, video, audio, file, booking_offer
  delivery_status String       @default("sent") // sent, delivered, seen
  read_at         DateTime?
  delivered_at    DateTime?
  created_at      DateTime     @default(now())
  
  // Replies
  parent_id       String?
  parent          Message?     @relation("MessageReplies", fields: [parent_id], references: [id], onDelete: SetNull)
  replies         Message[]    @relation("MessageReplies")
  
  // Custom states
  is_edited       Boolean      @default(false)
  
  // Relations
  attachments     Attachment[]
  reactions       Reaction[]
  
  @@index([conversation_id])
  @@index([sender_id])
  @@index([receiver_id])
  @@index([conversation_id, read_at]) // compound for unread count query
}

// --- Blocked Users ---
model BlockedUser {
  id          String   @id @default(uuid())
  blocker_id  String
  blocker     User     @relation("Blocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked_id  String
  blocked     User     @relation("Blocked", fields: [blocked_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now())

  @@unique([blocker_id, blocked_id])
}

// --- Message Attachments ---
model Attachment {
  id         String   @id @default(uuid())
  message_id String
  message    Message  @relation(fields: [message_id], references: [id], onDelete: Cascade)
  file_url   String
  file_name  String
  file_type  String   // image, video, audio, file
  file_size  Int?
  created_at DateTime @default(now())
  
  @@index([message_id])
}

// --- Message Reactions ---
model Reaction {
  id         String   @id @default(uuid())
  message_id String
  message    Message  @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  emoji      String
  created_at DateTime @default(now())

  @@unique([message_id, user_id])
}

// --- Booking Offers (Tenant <-> Owner) ---
model BookingOffer {
  id                  String       @id @default(uuid())
  conversation_id     String
  conversation        Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender_id           String
  sender              User         @relation("SentOffers", fields: [sender_id], references: [id], onDelete: Cascade)
  receiver_id         String
  receiver            User         @relation("ReceivedOffers", fields: [receiver_id], references: [id], onDelete: Cascade)
  room_id             String
  room                Room         @relation(fields: [room_id], references: [id], onDelete: Cascade)
  
  rent_amount         Int
  security_deposit    Int
  move_in_date        DateTime
  stay_duration       Int          // in months
  custom_message      String?
  
  status              String       @default("pending") // pending, accepted, rejected, countered
  counter_offer_id    String?      @unique
  parent_offer        BookingOffer? @relation("CounterOffers", fields: [counter_offer_id], references: [id])
  counter_offers      BookingOffer[] @relation("CounterOffers")
  
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt
  
  @@index([conversation_id])
}

// --- 13.10 Reviews ---
model Review {
  id                String   @id @default(uuid())
  room_id           String
  room              Room     @relation(fields: [room_id], references: [id])
  reviewer_id       String
  reviewer          User     @relation("Reviewer", fields: [reviewer_id], references: [id])
  reviewee_id       String
  reviewee          User     @relation("Reviewee", fields: [reviewee_id], references: [id])
  booking_id        String
  booking           Booking  @relation(fields: [booking_id], references: [id])
  rating            Int
  comment           String?
  moderation_status String   @default("approved")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

// --- 13.11 Reports ---
model Report {
  id           String    @id @default(uuid())
  reporter_id  String
  reporter     User      @relation(fields: [reporter_id], references: [id])
  target_type  String    // room, user, review
  target_id    String
  reason_code  String
  description  String?
  status       String    @default("pending")
  admin_action String?
  resolved_at  DateTime?
  created_at   DateTime  @default(now())
}

// --- 13.12 PointsTransactions ---
model PointsTransaction {
  id               String   @id @default(uuid())
  owner_id         String
  owner            User     @relation(fields: [owner_id], references: [id])
  room_id          String?
  room             Room?    @relation(fields: [room_id], references: [id])
  transaction_type String
  points           Int
  reason_code      String
  reference_id     String?
  balance_after    Int
  expires_at       DateTime?
  created_at       DateTime @default(now())

  @@index([owner_id])
  @@index([owner_id, reason_code]) // compound for duplicate-check queries
}

// --- 13.13 Notifications ---
model Notification {
  id                String   @id @default(uuid())
  user_id           String
  user              User     @relation(fields: [user_id], references: [id])
  notification_type String
  title             String
  body              String
  is_read           Boolean  @default(false)
  action_url        String?
  created_at        DateTime @default(now())

  @@index([user_id, is_read])
}

// --- 13.14 AdminActions ---
model AdminAction {
  id          String   @id @default(uuid())
  admin_id    String
  admin       User     @relation(fields: [admin_id], references: [id])
  action_type String
  target_type String
  target_id   String
  notes       String?
  created_at  DateTime @default(now())

  @@index([target_id])
  @@index([action_type, target_type]) // compound for suspension lookup
  @@index([admin_id])
}

// --- 13.15 RefreshTokens ---
model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([user_id])
}